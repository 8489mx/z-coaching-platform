# ==============================================================================
# Low-Data Mode Optimizer - Gemini Ignore Rules
# ==============================================================================

# Git internals
.git/

# Dependencies and Package Managers
node_modules/
**/node_modules/
frontend/node_modules/
.pnpm-store/
.yarn/

# Build and Bundle Outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
frontend/dist/
mobile_app/build/
mobile_app/.dart_tool/
.next/
.nuxt/
.svelte-kit/

# Workspaces, Agents, and Worktrees
.claude/
.agents/
backup_redesign_state/

# Archives, Zips, and Compressed Bundles
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
app-karimzakaria-bundle.zip
production-deploy.zip

# Backups and Database Dumps
backups/
**/backups/
*.bak
*.backup
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Logs and Debug Info
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
test_fails.log

# Temporary and Cache Directories
tmp/
temp/
scratch/
.cache/
.parcel-cache/
.turbo/
.temp/
*.tmp

# Test Coverage and Artifacts
coverage/
.nyc_output/
test-results/

# User Uploads, Heavy Assets, and Progress Media
uploads/
progress_photos/
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Binaries and Installers
*.exe
*.dll
*.dmg
*.pkg
*.so
*.dylib

# Secrets and Local Configurations
.env
.env.*
!.env.example
credentials/
secrets/
*.pem
*.key
*.p12
*.pfx
