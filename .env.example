# ==========================================================
# Z COACHING PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================================

# Server Configuration
PORT=3000
NODE_ENV=production
TZ=Africa/Cairo

# MySQL/MariaDB Configuration (From Hostinger hPanel -> Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=z
DB_USER=z_production_user
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DATABASE_PASSWORD_MIN_24_CHARS

# JWT & Authentication Secrets (Cryptographic 32+ char strings)
# Generate each one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit real values; this file is a template only.
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
INTAKE_JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
CSRF_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS

# Medical Data Encryption Key (MANDATORY IN PRODUCTION: 32+ chars)
# Changing it on a live system makes existing encrypted medical fields unreadable
# unless they are re-encrypted with the new key first.
MEDICAL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS

# CORS & Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://z-coaching.com,https://app.z-coaching.com

# Frontend API Base URL (Leave empty for same-origin unified Node server)
VITE_API_URL=

